{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NKF",
  "version": "0.6.0",
  "identifier": "org.nightknight.nkf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NKF — NightKnight Files",
        "width": 1360,
        "height": 860,
        "minWidth": 520,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
